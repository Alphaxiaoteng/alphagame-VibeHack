# ==========================================
# alphagame-VibeHack 环境变量配置模板
# 复制本文件为 .env.local 并填入实际 Key，切勿提交到 Git 仓库
# ==========================================

# 1. 3D 资产生成：Tripo 3D (CLI 已自动读取 ~/.tripo/config.json，代码调用可选填)
TRIPO_API_KEY=tsk_your_tripo_api_key_here
TRIPO_REGION=ov

# 2. 对话与角色语音：MiniMax (用于 NPC 对白与语音合成 TTS)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here

# 3. 语言模型与逻辑：智谱 AI (GLM-4 / GLM-Zero)
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# 4. 开源模型加速网关：硅基流动 SiliconFlow
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 5. 买断制收款：Waffo Pancake（仅服务端中间件读取，切勿加 VITE_ 前缀）
#    商户号与店铺号可在 Waffo 后台拿到；私钥只写进 .env.local，绝不入库、绝不进前端 bundle
WAFFO_MERCHANT_ID=MER_your_merchant_id_here
WAFFO_STORE_ID=STO_your_store_id_here
WAFFO_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n替换为你的 RSA 私钥\n-----END PRIVATE KEY-----
# test 用测试卡，prod 走真实扣款；不填默认 test
WAFFO_ENV=test
